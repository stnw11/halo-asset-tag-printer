# Copy this file to .env (gitignored) and fill in your tenant's real
# values. Loaded via python-dotenv (main.py, tools/*) when these vars
# aren't already set in the environment (e.g. by Docker).
#
# No inline trailing comments on value lines below -- confirmed that at
# least one env-file parser (docker compose's) doesn't reliably strip a
# "# comment" following an empty value, taking the comment text itself as
# the value instead. Comments live on their own line above the setting.

# --- Halo (required by src/main.py and tools/check_halo.py) --------------

HALO_BASE_URL=https://yourtenant.haloitsm.com
HALO_AUTH_URL=https://yourtenant.haloitsm.com/auth/token
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=

# Fill in once the saved list (4.9) exists -- not read by the code yet;
# get_pending() currently fetches every asset and filters client-side
# (see the project spec's open item 3 and section 4.8).
HALO_ASSET_VIEW_ID=

# The custom field's exact name as it appears in Halo's API (case
# sensitive) -- only change if you named it differently. The numeric id
# is Halo's own, assigned per tenant when you create the field
# (Configuration > Custom Fields, or Asset Fields depending on your
# version -- confirm which one your tenant's API actually exposes the
# value under, see the project spec's open item 3).
HALO_ASSET_TAG_QTY_FIELD_NAME=CFAssetTagPrintQTY
HALO_ASSET_TAG_QTY_FIELD_ID=

# --- Poll loop and guardrails (src/main.py) -------------------------------

POLL_INTERVAL_SECONDS=15
MAX_TAGS_PER_ASSET=5
MAX_ASSETS_PER_POLL=25

# First-run validation: polls, renders, and logs what it would print, but
# claims nothing and prints nothing. Worth one session against your live
# tenant before flipping this to 0.
SHADOW_MODE=1

# --- Printer hardware settings ---------------------------------------------
# Normally set in config/printers.yaml (copy config/printers.example.yaml
# first) -- these env vars are optional overrides on top of that, useful
# for quick one-off tuning without editing the YAML. If
# config/printers.yaml doesn't exist yet, these become the only source and
# neutral placeholder defaults apply.

# PRINTER_NAME=default          # which entry in config/printers.yaml to use

# RFC 5737 documentation address -- replace with your printer's real LAN
# IP; do not commit the real value.
PRINTER_IP=192.0.2.10
PRINTER_PORT=9100

# Confirm on your printer's status/config label.
DPI=300
LABEL_WIDTH_IN=0.5
LABEL_HEIGHT_IN=2.0

# gap or mark -- confirm against your stock.
MEDIA_SENSING=gap
# thermal_transfer (ribbon) or direct_thermal.
MEDIA_TYPE=thermal_transfer
# ZPL ^MD range 0-30; start conservative for resin ribbon.
DARKNESS=15
# inches/sec, ZPL ^PR.
PRINT_SPEED=2
RETRIES=3
COPIES=1

# --- Logo ------------------------------------------------------------------

LOGO_ASSET=assets/placeholder_logo.png
# threshold or dither.
LOGO_METHOD=threshold
# How often the running service re-checks the logo file for changes (lets
# you swap the file in the bind-mounted assets/ folder without a restart).
# Not used by tools/print_test_tag.py, which loads once per run.
LOGO_REFRESH_MINUTES=5

# --- Misc --------------------------------------------------------------

DRY_RUN=0
DRY_RUN_PATH=output.zpl
CONNECT_TIMEOUT=5.0
LOG_LEVEL=INFO
